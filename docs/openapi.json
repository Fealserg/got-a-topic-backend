  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^(accept|decline|cancel)$",
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "Action"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "FeedbackInput": {
        "properties": {
          "happened": {
            "type": "boolean",
            "title": "Happened"
          },
          "useful": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Useful"
          }
        },
        "type": "object",
        "required": [
          "happened"
        ],
        "title": "FeedbackInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InviteInput": {
        "properties": {
          "recipient_id": {
            "type": "integer",
            "title": "Recipient Id"
          },
          "slot_id": {
            "type": "integer",
            "title": "Slot Id"
          },
          "topic_id": {
            "type": "integer",
            "title": "Topic Id"
          },
          "message": {
            "type": "string",
            "maxLength": 300,
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "recipient_id",
          "slot_id",
          "topic_id"
        ],
        "title": "InviteInput"
      },
      "Profile": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "role": {
            "type": "string",
            "maxLength": 100,
            "title": "Role",
            "default": ""
          },
          "company": {
            "type": "string",
            "maxLength": 100,
            "title": "Company",
            "default": ""
          },
          "bio": {
            "type": "string",
            "maxLength": 500,
            "title": "Bio",
            "default": ""
          },
          "wanted": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Wanted"
          },
          "offered": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Offered"
          },
          "availability": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Availability"
          },
          "visible": {
            "type": "boolean",
            "title": "Visible"
          }
        },
        "type": "object",
        "required": [
          "name",
          "wanted",
          "offered",
          "availability",
          "visible"
        ],
        "title": "Profile"
      },
      "Register": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "name"
        ],
        "title": "Register"
      },
      "SlotInput": {
        "properties": {
          "starts_at": {
            "type": "integer",
            "title": "Starts At"
          },
          "ends_at": {
            "type": "integer",
            "title": "Ends At"
          },
          "location": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Location"
          }
        },
        "type": "object",
        "required": [
          "starts_at",
          "ends_at",
          "location"
        ],
        "title": "SlotInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "description": "Для изменяющих запросов введите pereryv.",
        "in": "header",
        "name": "X-Requested-With"
      }
    }
  }
}
